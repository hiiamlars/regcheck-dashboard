```gitignore
# Environment variables and virtual environment
.env
.venv/
env/
venv/

# Python
__pycache__/
*.py[cod]

# Logs
logs/
*.log

# Data
data/production/*
!data/production/.gitkeep

data/simulation/*
!data/simulation/.gitkeep

# Quarto
.quarto/
**/*.quarto_ipynb

# Generated output
output/
!output/figures/
!output/figures/.gitkeep
!output/scripts/
!output/scripts/.gitkeep

# Streamlit secrets
.streamlit/secrets.toml

# Local task scheduler configuration
setup_task_scheduler.ps1
```
